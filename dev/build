#!/usr/bin/env bash
# Copyright 2026 The Cogo Authors.
# SPDX-License-Identifier: Apache-2.0
#
# Build cogo locally with goreleaser-equivalent version metadata baked
# in via -ldflags. Without this, `go build ./cmd/cogo` produces a
# binary that reports "cogo dev (commit <vcs-sha>, built <vcs-time>)"
# — the new fallback in cmd/cogo/version.go pulls the SHA from
# runtime/debug.ReadBuildInfo, but the version string itself stays
# "dev". With this script, the binary reports `git describe`'s output
# instead — "v0.3.0" on a tagged commit, "v0.3.0-3-gabc1234" three
# commits past, "v0.3.0-3-gabc1234-dirty" with uncommitted changes.
#
# Usage:
#   dev/build                       # build to ./cogo
#   dev/build /tmp/cogo-test        # explicit output path
#   dev/build /tmp/cogo --race      # extra flags forwarded to go build

set -euo pipefail

OUT="${1:-./cogo}"
shift || true   # drop the output arg; remaining args go to go build

VERSION=$(git describe --tags --dirty --always 2>/dev/null || echo "dev")
COMMIT=$(git rev-parse HEAD 2>/dev/null || echo "none")
DATE=$(git log -1 --format=%cI 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%SZ)

# Mirror goreleaser's ldflags (.goreleaser.yaml).
LDFLAGS="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}"

exec go build -ldflags "$LDFLAGS" -o "$OUT" "$@" ./cmd/cogo
